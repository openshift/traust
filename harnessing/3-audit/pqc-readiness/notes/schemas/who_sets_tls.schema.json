{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "who_sets_tls.schema.json",
  "title": "Who sets TLS pattern table",
  "type": "object",
  "additionalProperties": false,
  "required": ["enum", "patterns", "explore_stop"],
  "properties": {
    "enum": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "this_app",
          "language_defaults",
          "platform",
          "mesh_or_ingress",
          "external_server",
          "unknown"
        ]
      }
    },
    "explore_stop": {
      "type": "string",
      "description": "When ownership is considered resolved"
    },
    "governance_map": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "this_app",
          "language_defaults",
          "platform",
          "mesh_or_ingress",
          "external_server",
          "unknown"
        ]
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match", "who_sets_tls"],
        "properties": {
          "match": {
            "type": "object",
            "additionalProperties": true
          },
          "who_sets_tls": {
            "enum": [
              "this_app",
              "language_defaults",
              "platform",
              "mesh_or_ingress",
              "external_server",
              "unknown"
            ]
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
