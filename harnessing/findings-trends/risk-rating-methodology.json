{
 "methodology": "OWASP Risk Rating Methodology",
 "methodology_version": "1.1.0",
 "source": "https://owasp.org/www-community/OWASP_Risk_Rating_Methodology",
 "documentation": "docs/risk-rating-methodology.md",
 "schema": "risk-rating-methodology.schema.json (traust-contracts, schemas/v1)",
 "bands": [
  "critical",
  "high",
  "medium",
  "low",
  "note"
 ],
 "bucket_thresholds": {
  "medium_min": 3,
  "high_min": 6
 },
 "likelihood_factors": {
  "AV": {
   "N": 9,
   "A": 7,
   "L": 5,
   "P": 3
  },
  "AC": {
   "L": 9,
   "H": 3
  },
  "PR": {
   "N": 9,
   "L": 5,
   "H": 2
  },
  "UI": {
   "N": 9,
   "R": 4
  }
 },
 "impact_factors": {
  "C": {
   "H": 9,
   "L": 4,
   "N": 0
  },
  "I": {
   "H": 9,
   "L": 4,
   "N": 0
  },
  "A": {
   "H": 9,
   "L": 4,
   "N": 0
  }
 },
 "matrix": {
  "LOW": {
   "LOW": "note",
   "MEDIUM": "low",
   "HIGH": "medium"
  },
  "MEDIUM": {
   "LOW": "low",
   "MEDIUM": "medium",
   "HIGH": "high"
  },
  "HIGH": {
   "LOW": "medium",
   "MEDIUM": "high",
   "HIGH": "critical"
  }
 },
 "fallback": {
  "default_likelihood": 4.5,
  "severity_impact": {
   "critical": 9.0,
   "high": 7.0,
   "medium": 5.0,
   "low": 2.0,
   "informational": 0.0
  }
 },
 "threat_intel_factor": {
  "description": "Exploitation-evidence likelihood factor: when a finding carries a CVE id and the feeds cache is present, KEV membership or the EPSS score adds one more likelihood factor alongside the CVSS exploitability metrics. Feeds: FIRST EPSS (attribution requested), CISA KEV (CC0-1.0).",
  "kev_score": 9,
  "epss_bands": [
   {
    "min_epss": 0.5,
    "score": 9
   },
   {
    "min_epss": 0.1,
    "score": 7
   },
   {
    "min_epss": 0.01,
    "score": 5
   },
   {
    "min_epss": 0.0,
    "score": 2
   }
  ]
 }
}
